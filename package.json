{
  "name": "golf-app",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . && pnpm lint:py",
    "lint:py": "tools/course-builder/.venv/bin/ruff check tools/course-builder",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run && pnpm test:py",
    "test:py": "tools/course-builder/.venv/bin/python -m pytest -q tools/course-builder",
    "build": "pnpm -r build",
    "format": "prettier --write . && tools/course-builder/.venv/bin/ruff format tools/course-builder",
    "setup:py": "python3 -m venv tools/course-builder/.venv && tools/course-builder/.venv/bin/pip install -q -e 'tools/course-builder[dev]'",
    "e2e": "pnpm --filter app build && pnpm --filter app e2e"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^3.2.7"
  },
  "type": "module"
}
